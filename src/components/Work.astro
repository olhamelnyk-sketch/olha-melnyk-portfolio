---
// Project cards. Images go in `image` (e.g. '/work/wellmedic.jpg')
// and `href` will point to the case page once it exists.
interface Project {
  title: string;
  type: string;
  format: string;
  description: string;
  placeholder: string;
  image?: string;
  href?: string;
}

const projects: Project[] = [
  {
    title: 'WellMedic+',
    type: 'Healthcare SaaS platform',
    format: 'Team of 3',
    description: 'Study project. My part: the patient experience, from sign-up to finding a doctor, booking and payment.',
    placeholder: 'Appointment & payment screen',
  },
  {
    title: 'DigiDiary',
    type: 'Mobile school app',
    format: 'Team of 2',
    description: 'Study project. My part: the student experience, almost all screens.',
    placeholder: 'Student dashboard',
  },
  {
    title: 'Art School',
    type: 'Website redesign',
    format: 'Solo',
    description: 'Study project. Redesign of the Viljandi Art School website.',
    placeholder: 'Before / after',
  },
  {
    title: 'Tabletochki',
    type: 'Charity landing concept',
    format: 'Solo',
    description: 'Concept charity landing page for Mother’s Day. Illustrations created by me together with AI.',
    placeholder: 'Mobile hero + gift cards',
  },
];
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container">
    <div class="section__inner">
      <h2 id="work-title" class="section__label">Selected work</h2>

      <div class="work-grid">
        {
          projects.map((p, i) => {
            const Tag = p.href ? 'a' : 'article';
            return (
              <Tag class="card" href={p.href}>
                <div class="card__media">
                  {p.image ? (
                    <img src={p.image} alt={`${p.title} — ${p.placeholder}`} loading="lazy" />
                  ) : (
                    <span class="card__placeholder">[ {p.placeholder} ]</span>
                  )}
                </div>
                <div class="card__meta">
                  <span>
                    {String(i + 1).padStart(2, '0')} - {p.type}
                  </span>
                  <span>{p.format}</span>
                </div>
                <h3 class="card__title">{p.title}</h3>
                <p class="card__text">{p.description}</p>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 76px;
    row-gap: 72px;
  }

  .card {
    display: block;
  }

  .card__media {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 3;
    overflow: hidden;
    background: var(--surface);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  a.card:hover .card__media img {
    transform: scale(1.03);
  }

  .card__placeholder {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 18px;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card__title {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.05em;
  }

  a.card:hover .card__title {
    color: var(--accent);
  }

  .card__text {
    max-width: 450px;
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .work-grid {
      grid-template-columns: 1fr;
      row-gap: 56px;
    }
    .card__title {
      font-size: 32px;
    }
  }
</style>
