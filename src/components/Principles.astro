---
const principles = [
  {
    title: 'Clarity over complexity',
    text: 'Complex things made clear: people see where they are and what’s next.',
  },
  {
    title: 'Function meets aesthetics',
    text: 'Beauty that serves the task, so every detail has a reason to be there.',
  },
  {
    title: 'User-first thinking',
    text: 'Every decision starts with who uses the product and what they need.',
  },
  {
    title: 'Continuous learning',
    text: 'Always growing, especially in AI-assisted design and prototyping.',
  },
];
---

<section class="section" aria-labelledby="principles-title">
  <div class="container">
    <div class="section__inner">
      <h2 id="principles-title" class="section__label">What I design by</h2>

      <ol class="principles">
        {
          principles.map((item, i) => (
            <li class="principle">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="principle__title">{item.title}</h3>
              <p class="principle__text">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .principles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 56px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principle__title {
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .principle__text {
    max-width: 260px;
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 48px;
    }
  }

  @media (max-width: 520px) {
    .principles {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
  }
</style>
