---
const steps = [
  { title: 'Concept', text: 'Who the product is for and what it should do.' },
  { title: 'Visual decisions', text: 'Type, layout and colour that support the content.' },
  { title: 'Interface logic', text: 'Flows and screens that feel obvious to use.' },
];

const tools = ['Figma', 'Adobe Photoshop', 'AI tools'];
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container">
    <div class="section__inner">
      <h2 id="about-title" class="section__label">About me</h2>

      <div class="about">
        <div class="about__photo">
          <span>[ Photo or line portrait ]</span>
        </div>

        <div class="about__content">
          <p class="about__lead">
            From architecture through photography to interfaces — I’ve always worked with{' '}
            <span class="accent-serif">structure and visual detail.</span>
          </p>

          <p class="about__text">
            I hold a master’s degree in architecture and completed the UX/UI Design course at GoIT. My focus is
            AI-assisted design and prototyping. I’m looking for a full-time Junior UX/UI Designer role.
          </p>

          <ol class="steps">
            {
              steps.map((step, i) => (
                <li>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="steps__title">{step.title}</h3>
                  <p class="steps__text">{step.text}</p>
                </li>
              ))
            }
          </ol>

          <p class="about__note">
            <span class="about__arrow" aria-hidden="true">&gt;</span> AI tools are part of my workflow — for example,
            I created the illustrations for the Tabletochki concept together with AI.
          </p>

          <ul class="tools" aria-label="Tools">
            {tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 80px;
  }

  .about__photo {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 6;
    background: var(--surface);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .about__lead {
    max-width: 700px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .about__text {
    max-width: 600px;
    margin: 44px 0 0;
    font-size: 16px;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .about__lead .accent-serif {
    display: block;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin: 34px 0 0;
    padding: 30px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .steps .num {
    font-size: 30px;
  }

  .steps__title {
    margin: 8px 0 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .steps__text {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.65;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .about__note {
    max-width: 560px;
    margin: 44px 0 0;
    font-size: 14px;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .about__arrow {
    color: var(--accent);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
  }

  .tools li {
    padding: 7px 14px;
    border: 1px solid var(--text);
    font-size: 14px;
    letter-spacing: 0.02em;
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .about__photo {
      width: 200px;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
