---
import BrainLine from './BrainLine.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__meta">
      <span>Portfolio</span>
      <span>Tallinn, Estonia</span>
    </div>

    <div class="hero__main">
      <h1 id="hero-title" class="hero__title">
        I design things you don’t have to <em>think</em> about.
      </h1>
      <div class="hero__brain"><BrainLine /></div>
    </div>

    <div class="hero__bottom">
      <div class="hero__role">
        <p class="hero__role-title">UX/UI Designer</p>
        <p class="hero__role-focus">AI-assisted Design &amp; Prototyping</p>
      </div>

      <div class="hero__actions">
        <a href="#work" class="btn btn--primary">
          see work
          <svg width="11" height="11" viewBox="0 0 11 11" aria-hidden="true">
            <path d="M2 9 9 2M3.5 2H9v5.5" fill="none" stroke="currentColor" stroke-width="1.3"></path>
          </svg>
        </a>
        <a href="#about" class="btn btn--outline">about me</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 112px 100px;
    border-bottom: 1px solid var(--line);
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 40px;
    margin-top: 48px;
  }

  .hero__title {
    margin: 0;
    max-width: 15ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(48px, 7vw, 100px);
    line-height: 1.04;
    letter-spacing: -0.05em;
  }

  .hero__title em {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .hero__brain {
    width: clamp(180px, 22vw, 300px);
    height: auto;
    margin-right: 10px;
    color: var(--text);
  }

  .hero__brain :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-top: 72px;
  }

  .hero__role p {
    margin: 0;
  }

  .hero__role-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.02em;
  }

  .hero__role-focus {
    margin-top: 4px !important;
    font-size: 16px;
    letter-spacing: 0.02em;
  }

  .hero__actions {
    display: flex;
    gap: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 50px;
    padding: 0 24px;
    border: 1px solid var(--btn-bg);
    font-size: 15px;
    letter-spacing: 0.04em;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn--primary {
    background: var(--btn-bg);
    color: var(--btn-text);
  }

  .btn--primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn--outline {
    color: var(--text);
  }

  .btn--outline:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .hero {
      padding-block: 64px 72px;
    }
    .hero__main {
      grid-template-columns: 1fr;
    }
    .hero__brain {
      order: -1;
      width: 160px;
      justify-self: end;
      margin-right: 0;
    }
    .hero__bottom {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 48px;
    }
  }

  @media (max-width: 420px) {
    .hero__actions {
      width: 100%;
    }
    .btn {
      flex: 1;
      padding: 0 16px;
    }
  }
</style>
